{
  "description": "1_to_1_close: AXIMM NMU (AxiRandomTrafficGenerator) + AXIMM NSU (BramEndpoint). Addresses match 1_to_1_close.nts NSU region (0x20100000000, size 0x10000).",
  "record_mode_interfaces": 2,
  "record_nps": 1,
  "record_nps_gap_cycles": 50,
  "nodes": [
    {
      "node_type": "AxiRandomTrafficGenerator",
      "connections": [
        {
          "connectTo": "NMU",
          "clock_domain": 500,
          "connectLoc": "NOC_NMU512_X0Y0",
          "protocol": "AXIMM"
        }
      ],
      "parameters": {
        "address_distribution": "INCREMENT",
        "align_addresses": false,
        "nsu_min_addrs": [2203318222848],
        "nsu_address_spaces": [65536],
        "min_transaction_size_bytes": 512,
        "max_transaction_size_bytes": 512,
        "max_write_commands": 1000
      }
    },
    {
      "node_type": "BramBuggyNode",
      "connections": [
        {
          "connectTo": "NSU",
          "clock_domain": 500,
          "connectLoc": "NOC_NSU512_X0Y0",
          "protocol": "AXIMM"
        }
      ],
      "parameters": {
        "sim_cycles": 10000000,
        "base_addr": 2203318222848,
        "memory_size": 65536,
        "read_latency": 1,
        "write_latency": 1,
        "awready_percentage": 100,
        "wready_percentage": 100,
        "arready_percentage": 100,
        "mutate_response_axi_id_percentage": 0,
        "mutate_axi_id_val": 0
      }
    }
  ],
  "noc_probes": [
    {
      "enabled": 0,
      "probe_id": "1",
      "probe_mode": "snooper",
      "hook_point_0": {
        "connectLoc": "nocinterface1",
        "hook_id": "noc_if.state.node_side",
        "fields": ["aximm.r.valid", "aximm.r.ready"],
        "print_cycles": 1
      }
    },
    {
      "enabled": 0,
      "path_match_trace": 1,
      "probe_id": "1",
      "probe_mode": "comparator",
      "comparator_op": "path_match",
      "hook_point_0": {
        "connectLoc": "nocinterface0",
        "hook_id": "noc_if.state.to_cdc"
      },
      "hook_point_1": {
        "connectLoc": "nocinterface1",
        "hook_id": "noc_if.cdc.to_node"
      }
    }
  ]
}
