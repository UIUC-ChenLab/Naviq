{
  "description": "Simulation and tracing options (formerly top-level keys in 1_to_1axis_node_config.json).",
  "record_mode_interfaces": 0,
  "record_nps": 1,
  "record_nps_gap_cycles": 50,
  "noc_probes": [
    {
      "enabled": 0,
      "probe_id": "1",
      "probe_mode": "snooper",
      "hook_point_0":
        {
          "connectLoc": "nocinterface0",
          "hook_id": "noc_if.state.node_side",
          "fields": ["axis.tlast", "axis.tkeep", "axis.tdata[0:15]"],
          "print_cycles": 1
        }
    },
    {
      "enabled": 0,
      "path_match_trace": 1,
      "probe_id": "1",
      "probe_mode": "comparator",
      "comparator_op": "latency",
      "hook_point_0":
        {
          "connectLoc": "nocinterface0",
          "hook_id": "noc_if.state.to_cdc"
        },
        "hook_point_1":
        {
          "connectLoc": "intlink1",
          "hook_id": "link.flit.enqueue"
        }
    },
    {
      "enabled": 0,
      "path_match_trace": 1,
      "probe_id": "1",
      "probe_mode": "comparator",
      "comparator_op": "path_match",
      "hook_point_0":
        {
          "connectLoc": "nocinterface0",
          "hook_id": "noc_if.state.to_cdc"
        },
        "hook_point_1":
        {
          "connectLoc": "nocinterface1",
          "hook_id": "noc_if.cdc.to_node"
        }
    }
  ]
}
