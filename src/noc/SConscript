Import('*')
Import('env')

import os

# ── External RTL toggle ──────────────────────────────────────────────
# Set to True to compile smartNIC RTL wrappers and FIFO RTL nodes.
# Can also be set from the command line:  scons BUILD_EXTERNAL_RTL=1 ...
BUILD_EXTERNAL_RTL = ARGUMENTS.get('BUILD_EXTERNAL_RTL', '0') == '1'
# ─────────────────────────────────────────────────────────────────────

env.AppendUnique(LIBS=['pcap'])

cpp_paths = [
    '#src/noc/lib/axi',
    '#src/noc/lib/interface',
    '#src/noc/lib/network',
    '#src/noc/lib/debug',
    '#src/noc/core/interface',
    '#src/noc/core/network',
    '#src/noc/core/control',
    '#src/noc/endpoints',
    '#src/noc/monitors',
    '#src/noc/ddr',
    '#src/noc/hbm',
    '#src/noc/topology',
    '#src/noc/debug',
    '#src/noc/lib/external/SystemVerilogAXI/axi_traffic/include',
    '#src/noc/lib/external/SystemVerilogAXI/axi_traffic/AxisTrafficGenerator',
    '#src/noc/lib/external/SystemVerilogAXI/axi_traffic/AxisTrafficGenerator/strategies',
    '#src/noc/lib/external/SystemVerilogAXI/axi_traffic/AxiTrafficGenerator',
    '#src/noc/lib/external/SystemVerilogAXI/axi_traffic/AxiTrafficGenerator/strategies',
    '#src/noc/endpoints/rtl/include',
]

if BUILD_EXTERNAL_RTL:
    cpp_paths += [
        '#src/noc/endpoints/rtl',
        '#src/rtl_simulation/build/axis_fifo_wrapper',
        '#src/rtl_simulation/build/packet_rate_limiter_wrapper',
        '#src/rtl_simulation/build/telemetry_wrapper',
        '#src/rtl_simulation/build/checksum_wrapper',
        '#src/rtl_simulation/build/segmentation_offload_wrapper',
        '#src/rtl_simulation/build/overloaded_nat_wrapper',
        '#src/rtl_simulation/build/ppe_base_none_wrapper',
        '#src/rtl_simulation/build/ppe_base_telemetry_wrapper',
        '#src/rtl_simulation/build/ppe_base_segmentation_wrapper',
        '#src/rtl_simulation/build/ppe_base_checksum_wrapper',
        '#src/rtl_simulation/build/ppe_base_nat_wrapper',
        '#src/rtl_simulation/build/ppe_base_flow_prefix_wrapper',
        '#src/rtl_simulation/build/ppe_base_five_tuple_hash_wrapper',
        '#src/rtl_simulation/build/ppe_2x_none_wrapper',
        '#src/rtl_simulation/build/ppe_2x_telemetry_wrapper',
        '#src/rtl_simulation/build/ppe_2x_segmentation_wrapper',
        '#src/rtl_simulation/build/ppe_2x_checksum_wrapper',
        '#src/rtl_simulation/build/ppe_2x_nat_wrapper',
        '#src/rtl_simulation/build/ppe_2x_flow_prefix_wrapper',
        '#src/rtl_simulation/build/ppe_2x_five_tuple_hash_wrapper',
    ]
    rtl_build_root = Dir('#src/rtl_simulation/build').abspath
    # The legacy hand-written nodes rely on independently generated Verilator
    # models.  A manifest-only build must not try to compile their headers
    # when those unrelated models have not been generated.  Generated nodes
    # below are discovered independently and remain available in that case.
    static_axis_fifo_model = os.path.isfile(
        os.path.join(rtl_build_root, 'axis_fifo_wrapper', 'axis_fifo_wrapper.h')
    )
    smartnic_model_headers = [
        'packet_rate_limiter_wrapper', 'telemetry_wrapper', 'checksum_wrapper',
        'segmentation_offload_wrapper', 'overloaded_nat_wrapper',
        'ppe_base_none_wrapper', 'ppe_base_telemetry_wrapper',
        'ppe_base_segmentation_wrapper', 'ppe_base_checksum_wrapper',
        'ppe_base_nat_wrapper', 'ppe_base_flow_prefix_wrapper',
        'ppe_base_five_tuple_hash_wrapper', 'ppe_2x_none_wrapper',
        'ppe_2x_telemetry_wrapper', 'ppe_2x_segmentation_wrapper',
        'ppe_2x_checksum_wrapper', 'ppe_2x_nat_wrapper',
        'ppe_2x_flow_prefix_wrapper', 'ppe_2x_five_tuple_hash_wrapper',
    ]
    static_smartnic_models = all(
        os.path.isfile(os.path.join(rtl_build_root, model, model + '.h'))
        for model in smartnic_model_headers
    )
    if not static_axis_fifo_model:
        print('RTL Simulation: legacy AxisFifoRtlNode model not built; skipping it')
    if not static_smartnic_models:
        print('RTL Simulation: legacy SmartNIC RTL models not all built; skipping them')
    if os.path.isdir(rtl_build_root):
        for generated_model in sorted(os.listdir(rtl_build_root)):
            generated_path = os.path.join(rtl_build_root, generated_model)
            if os.path.isdir(generated_path):
                cpp_paths.append(generated_path)

env.Append(CPPPATH=cpp_paths)

DebugFlag('NocTiming', 'Debug prints for NoC component timing and event scheduling')
DebugFlag('NocPacketFlow', 'Debug prints for NoC component general packet flow and processing')
DebugFlag('NocControl', 'Debug prints for Control loop and Tile/TileNSU tick updates')
DebugFlag('NocCDC', 'Debug prints for per-NI CDC queue enqueue/dequeue and latency')
DebugFlag('NocMemory', 'Debug prints for HBM/DDR memory controller interactions')
DebugFlag('NocHBM', 'Detailed HBM bringup traces (tile NSU arb/B channel, TG AXI handshake)')
DebugFlag('NocDebugVerbose', 'Verbose NoC debug (NI inNode, NSU outNode, NSU-NI stall, NMU outNode / niOutVc)')
DebugFlag('NocNI', 'Network interface detailed trace (assembler lock, credits, protocol)')

SimObject('endpoints/NocNode.py', sim_objects=['NocNode'])

SimObject('core/interface/NocInterface.py', sim_objects=['NocInterface'])

