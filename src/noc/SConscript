if BUILD_EXTERNAL_RTL:
    if static_axis_fifo_model:
        SimObject('endpoints/rtl/AxisFifoRtlNode.py', sim_objects=['AxisFifoRtlNode'])
    if static_smartnic_models:
        SimObject('endpoints/rtl/SmartNicRtlNodes.py', sim_objects=[
            'PacketRateLimiterRtlNode',
            'PacketRateLimiterThrottleRtlNode',
            'TelemetryRtlNode',
            'ChecksumRtlNode',
            'SegmentationOffloadRtlNode',
            'OverloadedNatRtlNode',
            'PacketProcessingEngineBaseNoneRtlNode',
            'PacketProcessingEngineBaseTelemetryRtlNode',
            'PacketProcessingEngineBaseSegmentationRtlNode',
            'PacketProcessingEngineBaseChecksumRtlNode',
            'PacketProcessingEngineBaseNatRtlNode',
            'PacketProcessingEngineBaseFlowPrefixRtlNode',
            'PacketProcessingEngineBaseFiveTupleHashRtlNode',
            'PacketProcessingEngine2xNoneRtlNode',
            'PacketProcessingEngine2xTelemetryRtlNode',
            'PacketProcessingEngine2xSegmentationRtlNode',
            'PacketProcessingEngine2xChecksumRtlNode',
            'PacketProcessingEngine2xNatRtlNode',
            'PacketProcessingEngine2xFlowPrefixRtlNode',
            'PacketProcessingEngine2xFiveTupleHashRtlNode'
        ])
    # Generated manifest-backed RTL nodes are opt-in: their generator writes
    # Python SimObject declarations here before SCons starts.
    generated_rtl_dir = Dir('endpoints/rtl/generated').srcnode().abspath
    if os.path.isdir(generated_rtl_dir):
        for generated_py in sorted(os.listdir(generated_rtl_dir)):
            if generated_py.endswith('.py'):
                SimObject(
                    'endpoints/rtl/generated/' + generated_py,
                    sim_objects=[os.path.splitext(generated_py)[0]],
                )
SimObject('endpoints/generator/TrafficGenerator.py', sim_objects=['TrafficGenerator'])
