{
  "kind": "naviq.connections",
  "version": 1,
  "name": "1nmu_to_1ddr",
  "components": {
    "tg_0": {
      "node_type": "AxiRandomTrafficGenerator",
      "ports": {
        "m_axi": {
          "role": "master",
          "protocol": "aximm"
        }
      }
    },
    "ddr0_port0": {
      "node_type": "BramEndpoint",
      "ports": {
        "s_axi": {
          "role": "slave",
          "protocol": "aximm",
          "type": "ddr",
          "base_address": "0x00000000",
          "size": "0x100000000"
        }
      }
    }
  },
  "connections": [
    {
      "from": "tg_0.m_axi",
      "to": "ddr0_port0.s_axi",
      "qos": {
        "read_bw": 500,
        "write_bw": 500,
        "read_avg_burst": 4,
        "write_avg_burst": 4
      }
    }
  ],
  "ddr_settings": {
    "num_mc": 1,
    "num_ports_per_mc": 1,
    "controller_type": "DDR4_SDRAM",
    "speed_grade": "DDR4-3200AC(24-24-24)",
    "data_width": 64,
    "memory_density": "8GB",
    "interleave_size_bytes": 256
  }
}
